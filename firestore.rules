rules_version = '2';
// SR Handicraft website — paste into Firebase console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function isSuper()  { return signedIn() && request.auth.token.email == 'deependrasinghbaghel30@gmail.com'; }
    function isAdmin()  { return isSuper() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))); }

    match /products/{id} { allow read: if true; allow write: if isAdmin(); }   // website reads, admins edit
    match /site/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /admins/{email} { allow read: if isAdmin(); allow write: if isSuper(); }
    match /{document=**} { allow read, write: if false; }
  }
}
